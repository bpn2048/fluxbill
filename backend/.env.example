# Postgres connection. Local docker-compose default below; in prod set the Neon URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/fluxbill

# OpenRouter LLM (free model works for the demo).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=FluxBill Backend
ASSISTANT_HISTORY_MAX_MESSAGES=12

# Whisper STT (tiny model = ~75MB, fastest cold start).
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://.*\.vercel\.app$

# Seed dummy data on first boot when tables are empty.
SEED_ON_STARTUP=true
